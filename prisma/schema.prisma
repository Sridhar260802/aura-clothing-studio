generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float
  costPrice   Float    @default(0)
  category    String
  images      String   @default("[]") // JSON array of image paths
  sizes       String   @default("[]") // JSON array of {size, stock}
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  customerName      String
  mobile            String
  address           String
  city              String
  state             String
  pincode           String
  items             String   // JSON array of order items
  subtotal          Float
  total             Float
  status            String   @default("Order Placed")
  paymentScreenshot String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  change    Int
  reason    String
  createdAt DateTime @default(now())
}
